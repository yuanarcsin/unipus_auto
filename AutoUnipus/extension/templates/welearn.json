{
  "siteId": "welearn",
  "siteName": "WE Learn (外教社)",
  "urlPatterns": [
    "*://welearn.sflep.com/*",
    "*://centercourseware.sflep.com/*"
  ],
  "urlRegex": "^https?://(?:welearn|centercourseware)\\.sflep\\.com/",
  "version": "1.1.0",
  "createdAt": "2026-05-28",
  "description": "WE Learn 主页面及课程内容 iframe。解析课程资源中的明确答案标记，并配对参考文本题；课程数据以当前页面实际网络请求为准。",
  "selectors": {
    "questionContainer": "et-stem et-choice, et-stem et-blank",
    "questionTypes": {
      "detectByAttribute": false,
      "blank_choice": {
        "container": "et-choice[join]",
        "title": "et-direction, p",
        "optionInput": "span",
        "optionLabel": "span",
        "clickTarget": "span"
      },
      "single_choice": {
        "container": "et-choice:not([join])",
        "title": "p, et-direction",
        "optionInput": "li",
        "optionLabel": "li",
        "clickTarget": "li"
      },
      "fill_blank": {
        "container": "et-blank",
        "title": "et-direction, p",
        "inputs": "input[type='text'], textarea, [contenteditable='true']"
      }
    }
  },
  "features": {
    "hasQuestionIndex": true,
    "hasTypeAttribute": false,
    "inputsHidden": false,
    "needClickWrapper": true,
    "autoScrollSupport": true,
    "isSPA": true,
    "useIframe": true,
    "iframeDomain": "centercourseware.sflep.com",
    "answerSource": "dataHtml",
    "tabbedContent": true
  },
  "notes": "课程资源可能在 data/{unit}/{section}.html 中提供 et-choice key / et-blank，也可能用 et-reveal 提供非唯一参考表达；后者仅展示与生成示例，不自动填答。若资源格式变化，需以 Network 抓包核对。"
}
